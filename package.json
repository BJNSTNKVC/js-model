{
  "name": "ts-laravel-model",
  "version": "0.1.0",
  "description": "TypeScript port of Laravel Eloquent's data-modeling layer.",
  "type": "module",
  "main": "./dist/main.cjs",
  "module": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/main.d.ts", "default": "./dist/main.js" },
      "require": { "types": "./dist/main.d.cts", "default": "./dist/main.cjs" }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/main.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^1.6.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^1.6.0"
  }
}
